{
  "name": "vice-city-bug-hunt-3d",
  "version": "0.1.0",
  "description": "Single-player browser 3D open-world game where you fix real JavaScript bugs to progress. Runs entirely in the browser; deploys as a static site.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "start": "node scripts/serve.js --dist",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.18.2",
    "monaco-editor": "0.52.2",
    "three": "0.180.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
